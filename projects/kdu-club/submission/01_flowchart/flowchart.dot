digraph flow {
graph [label="실선: 제어 흐름 / 점선: 데이터 조회·저장",fontname="Noto Sans CJK KR",fontsize=14,labelloc=b];
graph [rankdir=TB,bgcolor="white",nodesep=0.35,ranksep=0.45,dpi=160];
node [fontname="Noto Sans CJK KR",fontsize=12,style="filled",fillcolor="#F0F5FF",color="#3182F6",margin="0.12,0.08"];
edge [fontname="Noto Sans CJK KR",fontsize=10,color="#566277"];
S [label="시작: python app.py",shape=oval];
D [label="DB 경로/실행 옵션 결정",shape=box];
E [label="시연 DB가 있는가?",shape=diamond];
SE [label="seed_demo.py로 새 시연 DB 생성",shape=box];
DB [label="SQLite DB · 사용자/동아리/신청/공지/알림",shape=cylinder];
MG [label="누락된 필드·테이블 추가 / 비밀번호 해시 보완",shape=box];
RUN [label="Flask 서버 시작 / 브라우저 요청 대기",shape=box];
IN [label="URL·폼·파일 입력 / GET 또는 POST",shape=parallelogram];
CS [label="POST 토큰·역할/소유자 권한 유효?",shape=diamond];
ERR [label="400/403/404/409/413 오류 또는 입력 오류 안내",shape=parallelogram];
MENU [label="요청 경로에 따라 기능 선택",shape=diamond];
LOGIN [label="로그인/회원가입: 입력 검증·비밀번호 해시 확인",shape=box];
ROLE [label="로그인 성공? / 학생·교수 역할 구분",shape=diamond];
ST [label="학생: 탐색·내 활동·알림",shape=box];
PR [label="교수: 개설 신청 검토",shape=box];
SEARCH [label="목록·상세: 검색/필터·찜·일정·질문 조회",shape=box];
APPLY [label="가입 신청/취소: 모집 중·중복·대기 여부 검사",shape=box];
CREATE [label="개설/재신청: 이름·분야·소개 검증 / PDF 선택",shape=box];
OWNER [label="개설자: 모집·부원·공지·일정·Q&A 관리",shape=box];
VAL [label="입력·첨부 형식/용량·정원·상태 조건 충족?",shape=diamond];
TX [label="DB 변경 / 필요한 파일 저장 / 실패 시 롤백",shape=box];
NOTIFY [label="심사 대기 상태 변경인가?",shape=diamond];
N [label="신청자에게 결과 알림 1회 기록",shape=box];
VIEW [label="HTML/JSON 응답 / 화면 이동",shape=parallelogram];
READ [label="알림 조회·읽음: 사용자별 범위 확인",shape=box];
LOGOUT [label="로그아웃: 세션 삭제 후 초기 화면",shape=box];
ENDQ [label="서버 종료 요청(Ctrl+C)?",shape=diamond];
END [label="요청 DB 연결 종료 / 서버 중단",shape=oval];
DEP [label="현재 Python의 라이브러리 준비 완료?",shape=diamond];
ENV [label="프로젝트 .venv 생성 또는 재사용",shape=box];
LOCAL [label="전용 환경의 라이브러리 준비 완료?",shape=diamond];
INSTALL [label="pip 준비 / requirements.txt 자동 설치 / 재확인",shape=box];
RESTART [label="전용 Python으로 같은 실행 인자 재시작",shape=box];
S -> DEP;
DEP -> D [label="예"];
DEP -> ENV [label="아니오"];
ENV -> LOCAL;
LOCAL -> RESTART [label="예"];
LOCAL -> INSTALL [label="아니오"];
INSTALL -> RESTART [label="성공"];
RESTART -> DEP;
ENV -> BOOTERR [label="실패"];
INSTALL -> BOOTERR [label="실패 또는 중단"];
S -> BOOTERR [label="Python 버전 / 필수 파일 오류"];
D -> E;
E -> SE [label="없음"];
E -> MG [label="있음"];
SE -> MG;
SE -> DB [label="생성",style=dashed];
DB -> MG [label="읽기/보완",style=dashed];
MG -> RUN;
RUN -> IN [label="요청"];
IN -> CS;
CS -> ERR [label="아니오"];
CS -> MENU [label="예 또는 일반 GET"];
MENU -> LOGIN [label="로그인/가입"];
LOGIN -> ROLE;
ROLE -> ERR [label="실패"];
ROLE -> ST [label="학생"];
ROLE -> PR [label="교수"];
ST -> VIEW;
PR -> VIEW [label="조회",style=dashed];
PR -> VAL [label="심사 POST"];
MENU -> SEARCH [label="탐색/상세"];
SEARCH -> DB [label="조회",style=dashed];
SEARCH -> VIEW;
MENU -> APPLY [label="가입/취소"];
MENU -> CREATE [label="개설/재신청"];
MENU -> OWNER [label="동아리 관리"];
APPLY -> VAL;
CREATE -> VAL;
OWNER -> VAL [label="변경 POST"];
OWNER -> VIEW [label="조회 GET"];
VAL -> ERR [label="아니오"];
VAL -> TX [label="예"];
TX -> DB [label="저장",style=dashed];
TX -> ERR [label="예외 / 롤백"];
TX -> NOTIFY [label="성공"];
NOTIFY -> N [label="심사 상태 변경"];
NOTIFY -> VIEW [label="일반 저장/이미 처리됨"];
N -> DB [label="알림 저장",style=dashed];
N -> VIEW;
MENU -> READ [label="알림"];
READ -> DB [label="조회/읽음 저장",style=dashed];
READ -> VIEW;
MENU -> LOGOUT [label="로그아웃"];
LOGOUT -> VIEW;
ERR -> VIEW [label="입력 유지 / 안내"];
VIEW -> ENDQ [label="요청 DB 연결 닫기"];
ENDQ -> RUN [label="계속"];
ENDQ -> END [label="종료"];
BOOTERR [label="시작 단계 오류를 터미널에 출력",shape=parallelogram];
BOOTEND [label="서버 시작 중단",shape=oval];
SE -> BOOTERR [label="생성 실패"];
MG -> BOOTERR [label="DB 보완 실패"];
BOOTERR -> BOOTEND;
RUN -> END [label="Ctrl+C"];
}